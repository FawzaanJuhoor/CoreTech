<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coretech.coretech.ServicingFormController">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #2293C3; -fx-padding: 10;" HBox.hgrow="ALWAYS">
            <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 25px; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-family: Inder;" text="Manage Servicing" textAlignment="CENTER" HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <left>
        <VBox prefHeight="600.0" prefWidth="200.0" spacing="12" style="-fx-background-color: white; -fx-border-color: #2293C3;">
            <ImageView fitHeight="72.0" fitWidth="143.0">
                <Image url="@../../../Images/BlackVersion.png" />
                <VBox.margin>
                    <Insets left="30.0" />
                </VBox.margin>
                <effect>
                    <DropShadow offsetY="2.0">
                        <color>
                            <Color opacity="0.5896656513214111" />
                        </color>
                    </DropShadow>
                </effect> <!-- Keeping image path unchanged -->
            </ImageView>
            <Label prefHeight="20.0" fx:id="welcomeLabel" prefWidth="119.0" style="-fx-font-size: 14px; -fx-text-fill: black;">
                <VBox.margin>
                    <Insets bottom="30.0" left="50.0" />
                </VBox.margin></Label>

            <!-- Buttons with left-aligned text -->
            <Button fx:id="homeButton" onAction="#handleHome" prefHeight="26.0" prefWidth="199.0" style="-fx-background-color: white; -fx-text-fill: black; -fx-alignment: center-left;" text="Home">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10"> <!-- Add spacing between icon and text -->
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/home.png" />
                            <HBox.margin>
                                <Insets right="10.0" /> <!-- Add right padding to the icon -->
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>
            <Button fx:id="customerButton" onAction="#handleCustomerManagement" prefHeight="26.0" prefWidth="180.0" style="-fx-background-color: #FFFFFF; -fx-text-fill: #000000; -fx-alignment: center-left;" text="Customer Management">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/people.png" />
                            <HBox.margin>
                                <Insets right="10.0" /> <!-- Add right padding to the icon -->
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>
            <Button fx:id="vehicleButton" onAction="#handleVehicleManagement" prefHeight="26.0" prefWidth="192.0" style="-fx-background-color: #FFFFFF; -fx-text-fill: black; -fx-alignment: center-left;" text="Vehicle Management">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/car.png" />
                            <HBox.margin>
                                <Insets right="10.0" /> <!-- Add right padding to the icon -->
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>
            <Button fx:id="appointmentButton" onAction="#handleAppointments" prefHeight="26.0" prefWidth="166.0" style="-fx-background-color: #FFFFFF; -fx-text-fill: #000000; -fx-alignment: center-left;" text="Appointments">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/appointment.png" />
                            <HBox.margin>
                                <Insets right="10.0" /> <!-- Add right padding to the icon -->
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>

            <!-- Spacer to push the LogOut button to the bottom -->
            <VBox fx:id="spacer" VBox.vgrow="ALWAYS">
                <children>
                    <Button fx:id="serviceButton" onAction="#handleServicing" prefHeight="26.0" prefWidth="194.0" style="-fx-background-color: #A7DAF8; -fx-text-fill: #000000; -fx-alignment: center-left;" text="Servicing">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                    <Image url="@../../../Images/icons/service.png" />
                                    <HBox.margin>
                                        <Insets right="10.0" /> <!-- Add right padding to the icon -->
                                    </HBox.margin>
                                </ImageView>
                            </HBox>
                        </graphic>
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                    </Button>
                </children>
            </VBox>

            <!-- Log Out Button -->
            <Button fx:id="logoutButton" onAction="#handleLogout" prefHeight="26.0" prefWidth="201.0"
                    style="-fx-background-color: #2293C3; -fx-text-fill: white; -fx-font-weight: bold;" text="Log Out">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10"> <!-- Add spacing between icon and text -->
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/logout-white.png" />
                            <HBox.margin>
                                <Insets right="10.0" /> <!-- Add right padding to the icon -->
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <VBox fx:id="centerPane" alignment="CENTER" spacing="30" style="-fx-padding: 30; -fx-background-color: #EFEFEF; -fx-border-color: #2293C3;" >
        <!-- Add Item Form -->
        <VBox fx:id="addForm" alignment="CENTER" spacing="25" style="-fx-padding: 30; -fx-background-color: #EFEFEF;"
              VBox.vgrow="ALWAYS">
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2293C3;" text="Add Item" />

            <HBox alignment="CENTER" spacing="20" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;" text="Appointment ID:" />
                <TextField fx:id="addAppointmentIDField" prefWidth="250.0" promptText="Enter Appointment ID" style="-fx-font-size: 14px;" />
            </HBox>
            <HBox alignment="CENTER" spacing="20" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;" text="Item ID:" />
                <TextField fx:id="addItemID" prefWidth="250.0" promptText="Enter Item ID" style="-fx-font-size: 14px;" />
            </HBox>
            <HBox alignment="CENTER" spacing="20" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;" text="Quantity:" />
                <TextField fx:id="addQuantity" prefWidth="250.0" promptText="Enter Quantity" style="-fx-font-size: 14px;" />
            </HBox>


            <HBox alignment="CENTER" spacing="40" style="-fx-padding: 10;">
                <!-- Add Button with Icon -->
                <Button fx:id="addServiceButton" onAction="#handleAddService" style="-fx-background-color: #198B2C; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-pref-width: 120; -fx-pref-height: 40;" text="ADD">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10"> <!-- Add spacing between icon and text -->
                            <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                <Image url="@../../../Images/icons/add-white.png" /> <!-- Path to your add icon -->
                                <HBox.margin>
                                    <Insets right="10.0" /> <!-- Add right padding to the icon -->
                                </HBox.margin>
                            </ImageView>
                        </HBox>
                    </graphic>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </Button>

                <Button fx:id="cancelAddButton" onAction="#clearForm" style="-fx-background-color: #2293C3; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-pref-width: 120; -fx-pref-height: 40;" text="CANCEL">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10"> <!-- Add spacing between icon and text -->
                            <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                <Image url="@../../../Images/icons/cancle.png" /> <!-- Path to your cancel icon -->
                                <HBox.margin>
                                    <Insets right="10.0" /> <!-- Add right padding to the icon -->
                                </HBox.margin>
                            </ImageView>
                        </HBox>
                    </graphic>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </Button>
            </HBox>
        </VBox>
        </VBox>

    </center>

</BorderPane>