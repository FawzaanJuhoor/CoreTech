<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane fx:controller="com.coretech.coretech.ViewVehicleController" xmlns:fx="http://javafx.com/fxml">
    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #2293C3; -fx-padding: 10;" HBox.hgrow="ALWAYS">
            <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 25px; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-family: Inder;" text="Manage Vehicles" textAlignment="CENTER" HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <!-- Left Sidebar -->
    <left>
        <VBox minWidth="150.0" maxWidth="250.0" spacing="12" style="-fx-background-color: white; -fx-border-color: #2293C3;" VBox.vgrow="ALWAYS">
            <ImageView fitHeight="72.0" fitWidth="143.0" preserveRatio="true">
                <Image url="@../../../Images/BlackVersion.png" />
                <VBox.margin>
                    <Insets left="30.0" />
                </VBox.margin>
                <effect>
                    <DropShadow offsetY="2.0">
                        <color>
                            <Color opacity="0.5896656513214111" />
                        </color>
                    </DropShadow>
                </effect>
            </ImageView>
            <Label style="-fx-font-size: 14px; -fx-text-fill: black;" text="Welcome, Name">
                <VBox.margin>
                    <Insets bottom="30.0" left="50.0" />
                </VBox.margin>
            </Label>

            <!-- Home Button -->
            <Button onAction="#handleHome" style="-fx-background-color: white; -fx-text-fill: #000000; -fx-alignment: center-left;" text="Home" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/home.png" />
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>

            <!-- Customer Management Button -->
            <Button onAction="#handleCustomerManagement" style="-fx-background-color: #FFFFFF; -fx-text-fill: #000000; -fx-alignment: center-left;" text="Customer Management" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/people.png" />
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>

            <!-- Vehicle Management Button -->
            <Button onAction="#handleVehicleManagement" style="-fx-background-color: #A7DAF8; -fx-text-fill: #000000; -fx-alignment: center-left;" text="Vehicle Management" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/car.png" />
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>

            <!-- Appointments Button -->
            <Button onAction="#handleAppointments" style="-fx-background-color: #FFFFFF; -fx-text-fill: #000000; -fx-alignment: center-left;" text="Appointments" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/appointment.png" />
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>

            <!-- Spacer and Servicing Button -->
            <VBox fx:id="spacer" VBox.vgrow="ALWAYS">
                <children>
                    <Button onAction="#handleServicing" style="-fx-background-color: #FFFFFF; -fx-text-fill: #000000; -fx-alignment: center-left;" text="Servicing" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                    <Image url="@../../../Images/icons/service.png" />
                                    <HBox.margin>
                                        <Insets right="10.0" />
                                    </HBox.margin>
                                </ImageView>
                            </HBox>
                        </graphic>
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                    </Button>
                </children>
            </VBox>

            <!-- Log Out Button -->
            <Button onAction="#handleLogout" style="-fx-background-color: #2293C3; -fx-text-fill: white; -fx-font-weight: bold;" text="Log Out" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/logout-white.png" />
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>
        </VBox>
    </left>

    <!-- Center Content -->
    <center>
        <StackPane fx:id="contentPane" maxWidth="Infinity">
            <VBox fx:id="mainVehicleView" spacing="20" style="-fx-padding: 20" VBox.vgrow="ALWAYS" visible="true" managed="true">
                <HBox alignment="CENTER">
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2293C3;" alignment="CENTER" text="View Vehicles" />
                </HBox>
                <HBox spacing="10" alignment="CENTER">
                    <TextField fx:id="searchField" promptText="Enter VIN" prefWidth="200"/>
                    <Button fx:id="searchButton" style="-fx-background-color: #2293C3;" text="Search" onAction="#handleSearch"/>
                </HBox>
                <ScrollPane fx:id="scrollPane" fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS" vbarPolicy="AS_NEEDED" hbarPolicy="AS_NEEDED">
                    <content>
                        <TableView fx:id="vehicleTable">
                            <columns>
                                <TableColumn fx:id="idColumn" text="ID" prefWidth="50" minWidth="50" resizable="true"/>
                                <TableColumn fx:id="vinColumn" text="VIN" prefWidth="150" minWidth="120" resizable="true"/>
                                <TableColumn fx:id="emailColumn" text="Email" prefWidth="150" minWidth="120" resizable="true"/>
                                <TableColumn fx:id="makeColumn" text="Make" prefWidth="100" minWidth="80" resizable="true"/>
                                <TableColumn fx:id="modelColumn" text="Model" prefWidth="120" minWidth="80" resizable="true"/>
                                <TableColumn fx:id="yearColumn" text="Year" prefWidth="60" minWidth="50" resizable="true"/>
                                <TableColumn fx:id="servicingHistoryColumn" text="Servicing History" prefWidth="200" minWidth="150" resizable="true"/>
                                <TableColumn fx:id="actionColumn" text="Action" prefWidth="150" minWidth="100" resizable="true"/>
                            </columns>
                        </TableView>
                    </content>
                </ScrollPane>
            </VBox>
            <!-- View Vehicle Form -->
            <VBox fx:id="viewVehicleForm" alignment="CENTER" spacing="25" style="-fx-padding: 30; -fx-background-color: #EFEFEF;" visible="false" managed="false">
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2293C3;" text="View Vehicles" />
                <HBox alignment="CENTER" spacing="10">
                    <TextField fx:id="viewSearchField" prefHeight="30.0" promptText="Enter VIN" style="-fx-font-size: 12px; -fx-pref-width: 250; -fx-max-width: 300;" HBox.hgrow="ALWAYS" />
                    <Button fx:id="viewSearchButton" onAction="#handleViewSearch" style="-fx-background-color: #2293C3; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-pref-width: 80; -fx-pref-height: 30;" text="SEARCH" />
                </HBox>
                <ScrollPane fx:id="viewScrollPane" fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS" vbarPolicy="AS_NEEDED" hbarPolicy="AS_NEEDED">
                    <content>
                        <TableView fx:id="viewVehicleTable">
                            <columns>
                                <TableColumn fx:id="viewIdColumn" text="ID" prefWidth="50" resizable="true" />
                                <TableColumn fx:id="viewVinColumn" text="VIN" prefWidth="150" resizable="true" />
                                <TableColumn fx:id="viewEmailColumn" text="Email" prefWidth="150" resizable="true" />
                                <TableColumn fx:id="viewMakeColumn" text="Make" prefWidth="100" resizable="true" />
                                <TableColumn fx:id="viewModelColumn" text="Model" prefWidth="120" resizable="true" />
                                <TableColumn fx:id="viewYearColumn" text="Year" prefWidth="60" resizable="true" />
                                <TableColumn fx:id="viewServicingHistoryColumn" text="Servicing History" prefWidth="200" resizable="true" />
                                <TableColumn fx:id="viewActionColumn" text="Actions" prefWidth="120" resizable="true" />
                            </columns>
                        </TableView>
                    </content>
                </ScrollPane>
            </VBox>
        </StackPane>
    </center>
    <!-- Right Sidebar -->
    <right>
        <AnchorPane minWidth="200.0" maxWidth="350.0" style="-fx-border-color: #2293C3;" VBox.vgrow="ALWAYS">
            <Button fx:id="addVehicleButton" onAction="#handleAddVehicle"
                    style="-fx-background-color: white; -fx-text-fill: #2293C3; -fx-border-color: #2293C3;"
                    text="Add Vehicle"
                    AnchorPane.topAnchor="100.0" AnchorPane.leftAnchor="4.0" AnchorPane.rightAnchor="4.0" />
            <Button fx:id="updateVehicleButton" onAction="#handleUpdateVehicle"
                    style="-fx-background-color: white; -fx-text-fill: #2293C3; -fx-border-color: #2293C3;"
                    text="Update Vehicle Info"
                    AnchorPane.topAnchor="170.0" AnchorPane.leftAnchor="4.0" AnchorPane.rightAnchor="4.0" />
            <Button fx:id="removeVehicleButton" onAction="#handleRemoveVehicle"
                    style="-fx-background-color: white; -fx-text-fill: #2293C3; -fx-border-color: #2293C3;"
                    text="Remove Vehicle"
                    AnchorPane.topAnchor="240.0" AnchorPane.leftAnchor="4.0" AnchorPane.rightAnchor="4.0" />
            <Button fx:id="servicingDetailsButton" onAction="#handleServicingDetails"
                    style="-fx-background-color: white; -fx-text-fill: #2293C3; -fx-border-color: #2293C3;"
                    text="Servicing Details"
                    AnchorPane.topAnchor="310.0" AnchorPane.leftAnchor="4.0" AnchorPane.rightAnchor="4.0" />
            <Button fx:id="viewVehicleButton" onAction="#handleViewVehicle"
                    style="-fx-background-color: #2293C3; -fx-text-fill: #000000; -fx-border-color: #2293C3;"
                    text="View Vehicle"
                    AnchorPane.topAnchor="380.0" AnchorPane.leftAnchor="4.0" AnchorPane.rightAnchor="4.0" />
        </AnchorPane>
    </right>
</BorderPane>