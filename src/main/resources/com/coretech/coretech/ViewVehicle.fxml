<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane fx:controller="com.coretech.coretech.ViewVehicleController" xmlns:fx="http://javafx.com/fxml">
    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #2293C3; -fx-padding: 10;" HBox.hgrow="ALWAYS">
            <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 25px; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-family: Inder;" text="Manage Vehicles" textAlignment="CENTER" HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <!-- Left Sidebar -->
    <left>
        <VBox prefHeight="600.0" prefWidth="200.0" spacing="12" style="-fx-background-color: white; -fx-border-color: #2293C3;">
            <ImageView fitHeight="72.0" fitWidth="143.0">
                <Image url="@../../../Images/BlackVersion.png" />
                <VBox.margin>
                    <Insets left="30.0" />
                </VBox.margin>
                <effect>
                    <DropShadow offsetY="2.0">
                        <color>
                            <Color opacity="0.5896656513214111" />
                        </color>
                    </DropShadow>
                </effect> <!-- Keeping image path unchanged -->
            </ImageView>
            <Label prefHeight="20.0" fx:id="welcomeLabel" prefWidth="119.0" style="-fx-font-size: 14px; -fx-text-fill: black;">
                <VBox.margin>
                    <Insets bottom="30.0" left="50.0" />
                </VBox.margin></Label>

            <!-- Buttons with left-aligned text -->
            <Button fx:id="homeButton" onAction="#handleHome" prefHeight="26.0" prefWidth="199.0" style="-fx-background-color: white; -fx-text-fill: black; -fx-alignment: center-left;" text="Home">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10"> <!-- Add spacing between icon and text -->
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/home.png" />
                            <HBox.margin>
                                <Insets right="10.0" /> <!-- Add right padding to the icon -->
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>
            <Button fx:id="customerButton" onAction="#handleCustomerManagement" prefHeight="26.0" prefWidth="180.0" style="-fx-background-color: #FFFFFF; -fx-text-fill: #000000; -fx-alignment: center-left;" text="Customer Management">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/people.png" />
                            <HBox.margin>
                                <Insets right="10.0" /> <!-- Add right padding to the icon -->
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>
            <Button fx:id="vehicleButton" onAction="#handleVehicleManagement" prefHeight="26.0" prefWidth="192.0" style="-fx-background-color: #A7DAF8; -fx-text-fill: black; -fx-alignment: center-left;" text="Vehicle Management">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/car.png" />
                            <HBox.margin>
                                <Insets right="10.0" /> <!-- Add right padding to the icon -->
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>
            <Button fx:id="appointmentButton" onAction="#handleAppointments" prefHeight="26.0" prefWidth="166.0" style="-fx-background-color: #FFFFFF; -fx-text-fill: #000000; -fx-alignment: center-left;" text="Appointments">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/appointment.png" />
                            <HBox.margin>
                                <Insets right="10.0" /> <!-- Add right padding to the icon -->
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>

            <!-- Spacer to push the LogOut button to the bottom -->
            <VBox fx:id="spacer" VBox.vgrow="ALWAYS">
                <children>
                    <Button fx:id="serviceButton" onAction="#handleServicing" prefHeight="26.0" prefWidth="194.0" style="-fx-background-color: #FFFFFF; -fx-text-fill: #000000; -fx-alignment: center-left;" text="Servicing">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                    <Image url="@../../../Images/icons/service.png" />
                                    <HBox.margin>
                                        <Insets right="10.0" /> <!-- Add right padding to the icon -->
                                    </HBox.margin>
                                </ImageView>
                            </HBox>
                        </graphic>
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                    </Button>
                </children>
            </VBox>

            <!-- Log Out Button -->
            <Button fx:id="logoutButton" onAction="#handleLogout" prefHeight="26.0" prefWidth="201.0"
                    style="-fx-background-color: #2293C3; -fx-text-fill: white; -fx-font-weight: bold;" text="Log Out">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10"> <!-- Add spacing between icon and text -->
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/logout-white.png" />
                            <HBox.margin>
                                <Insets right="10.0" /> <!-- Add right padding to the icon -->
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>
        </VBox>
    </left>
    <!-- Center Content -->
    <center>
        <StackPane fx:id="contentPane" maxWidth="Infinity">
            <!-- View Vehicle Form -->
            <VBox fx:id="viewVehicleForm" alignment="CENTER" spacing="25" style="-fx-padding: 30; -fx-background-color: #EFEFEF;" VBox.vgrow="ALWAYS" visible="true" managed="true">
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2293C3;" text="View Vehicles" />
                <HBox alignment="CENTER" spacing="10">
                    <TextField fx:id="viewSearchField" prefHeight="30.0" promptText="Enter VIN" style="-fx-font-size: 12px; -fx-pref-width: 250; -fx-max-width: 300;" HBox.hgrow="ALWAYS" />
                    <Button fx:id="viewSearchButton" onAction="#handleViewSearch" style="-fx-background-color: #2293C3; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-pref-width: 80; -fx-pref-height: 30;" text="SEARCH" />
                </HBox>
                <ScrollPane fx:id="viewScrollPane"
                            fitToHeight="true"
                            fitToWidth="false"
                            VBox.vgrow="ALWAYS"
                            hbarPolicy="AS_NEEDED"
                            vbarPolicy="AS_NEEDED"
                            style="-fx-padding: 0;">
                    <content>
                        <HBox fx:id="tableWrapper" >
                            <TableView fx:id="vehicleTable" minWidth="1000">
                                <columns>
                                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50" />
                                    <TableColumn fx:id="vinColumn" text="VIN" prefWidth="150" />
                                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="150" />
                                    <TableColumn fx:id="makeColumn" text="Make" prefWidth="100" />
                                    <TableColumn fx:id="modelColumn" text="Model" prefWidth="120" />
                                    <TableColumn fx:id="yearColumn" text="Year" prefWidth="60" />
                                    <TableColumn fx:id="servicingHistoryColumn" text="Servicing History" prefWidth="200" />
                                    <TableColumn fx:id="actionColumn" text="Actions" prefWidth="120" />
                                </columns>
                            </TableView>
                        </HBox>
                    </content>
                </ScrollPane>

            </VBox>
        </StackPane>
    </center>
    <!-- Right Sidebar -->
    <right>
        <AnchorPane minWidth="200.0" maxWidth="350.0" style="-fx-border-color: #2293C3;" VBox.vgrow="ALWAYS">
            <Button fx:id="addVehicleButton" onAction="#handleAddVehicle"
                    style="-fx-background-color: white; -fx-text-fill: #2293C3; -fx-border-color: #2293C3;"
                    text="Add Vehicle"
                    AnchorPane.topAnchor="100.0" AnchorPane.leftAnchor="4.0" AnchorPane.rightAnchor="4.0" />
            <Button fx:id="updateVehicleButton" onAction="#handleUpdateVehicle"
                    style="-fx-background-color: white; -fx-text-fill: #2293C3; -fx-border-color: #2293C3;"
                    text="Update Vehicle Info"
                    AnchorPane.topAnchor="170.0" AnchorPane.leftAnchor="4.0" AnchorPane.rightAnchor="4.0" />
            <Button fx:id="removeVehicleButton" onAction="#handleRemoveVehicle"
                    style="-fx-background-color: white; -fx-text-fill: #2293C3; -fx-border-color: #2293C3;"
                    text="Remove Vehicle"
                    AnchorPane.topAnchor="240.0" AnchorPane.leftAnchor="4.0" AnchorPane.rightAnchor="4.0" />
            <Button fx:id="servicingDetailsButton" onAction="#handleServicingDetails"
                    style="-fx-background-color: white; -fx-text-fill: #2293C3; -fx-border-color: #2293C3;"
                    text="Servicing Details"
                    AnchorPane.topAnchor="310.0" AnchorPane.leftAnchor="4.0" AnchorPane.rightAnchor="4.0" />
            <Button fx:id="viewVehicleButton" onAction="#handleViewVehicle"
                    style="-fx-background-color: #2293C3; -fx-text-fill: #000000; -fx-border-color: #2293C3;"
                    text="View Vehicle"
                    AnchorPane.topAnchor="380.0" AnchorPane.leftAnchor="4.0" AnchorPane.rightAnchor="4.0" />
        </AnchorPane>
    </right>
</BorderPane>