<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.TextArea?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ComboBox?>
<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.coretech.coretech.AppointmentController">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #2293C3; -fx-padding: 10;" HBox.hgrow="ALWAYS">
            <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 25px; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-family: Inder;" text="Manage Customer" textAlignment="CENTER" HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <!-- Left Sidebar -->
    <left>
        <VBox minWidth="150.0" maxWidth="250.0" spacing="12" style="-fx-background-color: white; -fx-border-color: #2293C3;" VBox.vgrow="ALWAYS">
            <ImageView fitHeight="72.0" fitWidth="143.0" preserveRatio="true">
                <Image url="@../../../Images/BlackVersion.png" />
                <VBox.margin>
                    <Insets left="30.0" />
                </VBox.margin>
                <effect>
                    <DropShadow offsetY="2.0">
                        <color>
                            <Color opacity="0.5896656513214111" />
                        </color>
                    </DropShadow>
                </effect>
            </ImageView>
            <Label style="-fx-font-size: 14px; -fx-text-fill: black;" text="Welcome, Name">
                <VBox.margin>
                    <Insets bottom="30.0" left="50.0" />
                </VBox.margin>
            </Label>

            <!-- Home Button -->
            <Button onAction="#handleHome" style="-fx-background-color: white; -fx-text-fill: #000000; -fx-alignment: center-left;" text="Home" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10"> <!-- Add spacing between icon and text -->
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/home.png" />
                            <HBox.margin>
                                <Insets right="10.0" /> <!-- Add right padding to the icon -->
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>

            <!-- Customer Management Button -->
            <Button onAction="#handleCustomerManagement" style="-fx-background-color: #FFFFFF; -fx-text-fill: #000000; -fx-alignment: center-left;" text="Customer Management" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/people.png" />
                            <HBox.margin>
                                <Insets right="10.0" /> <!-- Add right padding to the icon -->
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>

            <!-- Vehicle Management Button -->
            <Button onAction="#handleVehicleManagement" style="-fx-background-color: #FFFFFF; -fx-text-fill: #000000; -fx-alignment: center-left;" text="Vehicle Management" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/car.png" />
                            <HBox.margin>
                                <Insets right="10.0" /> <!-- Add right padding to the icon -->
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>

            <!-- Appointments Button -->
            <Button onAction="#handleAppointments" style="-fx-background-color: #A7DAF8; -fx-text-fill: #000000; -fx-alignment: center-left;" text="Appointments" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/appointment.png" />
                            <HBox.margin>
                                <Insets right="10.0" /> <!-- Add right padding to the icon -->
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>

            <!-- Spacer and Servicing Button -->
            <VBox fx:id="spacer" VBox.vgrow="ALWAYS">
                <children>
                    <Button onAction="#handleServicing" style="-fx-background-color: #FFFFFF; -fx-text-fill: #000000; -fx-alignment: center-left;" text="Servicing" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                    <Image url="@../../../Images/icons/service.png" />
                                    <HBox.margin>
                                        <Insets right="10.0" /> <!-- Add right padding to the icon -->
                                    </HBox.margin>
                                </ImageView>
                            </HBox>
                        </graphic>
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                    </Button>
                </children>
            </VBox>

            <!-- Log Out Button -->
            <Button onAction="#handleLogout" style="-fx-background-color: #2293C3; -fx-text-fill: white; -fx-font-weight: bold;" text="Log Out" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10"> <!-- Add spacing between icon and text -->
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../../../Images/icons/logout-white.png" />
                            <HBox.margin>
                                <Insets right="10.0" /> <!-- Add right padding to the icon -->
                            </HBox.margin>
                        </ImageView>
                    </HBox>
                </graphic>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </Button>
        </VBox>
    </left>
    <!-- Center Content - Dynamic View -->
    <center>
        <VBox fx:id="centerPane" alignment="CENTER" spacing="30" style="-fx-padding: 30; -fx-background-color: #EFEFEF; -fx-border-color: #2293C3;" VBox.vgrow="ALWAYS">

            <!-- Add Appointment Form -->
            <VBox fx:id="addForm" alignment="CENTER" prefHeight="646.0" prefWidth="498.0" spacing="30" style="-fx-padding: 30; -fx-background-color: #EFEFEF; -fx-border-color: #2293C3;">
                <!-- Form Title -->
                <Label fx:id="formTitleLabel" alignment="CENTER" contentDisplay="CENTER" maxWidth="Infinity" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2293C3;" text="Add Appointment" textAlignment="CENTER" />

                <!-- Form Fields -->
                <VBox fx:id="formContainer" alignment="CENTER" prefHeight="494.0" prefWidth="435.0" spacing="25" style="-fx-padding: 30; -fx-background-color: white;">

                    <!-- VIN (auto fetch vehicle info) -->
                    <HBox fx:id="vinBox" alignment="CENTER" spacing="20">
                        <Label text="VIN:" style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;" />
                        <TextField fx:id="vinTextField" promptText="Enter VIN" style="-fx-pref-width: 250; -fx-font-size: 14px;" />
                    </HBox>

                    <!-- Service Type Dropdown -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label text="Service Type:" style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;" />
                        <ComboBox fx:id="serviceTypeComboBox" style="-fx-pref-width: 250; -fx-font-size: 14px;" />
                    </HBox>

                    <!-- Mechanic Dropdown -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label text="Mechanic:" style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;" />
                        <ComboBox fx:id="mechanicComboBox" style="-fx-pref-width: 250; -fx-font-size: 14px;" />
                    </HBox>

                    <!-- Service Date -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label text="Service Date:" style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;" />
                        <DatePicker fx:id="serviceDatePicker" style="-fx-pref-width: 250; -fx-font-size: 14px;" />
                    </HBox>

                    <!-- Service Status -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label text="Status:" style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;" />
                        <ComboBox fx:id="statusComboBox" style="-fx-pref-width: 250; -fx-font-size: 14px;" />
                    </HBox>

                    <!-- Buttons -->
                    <HBox fx:id="buttonContainer" alignment="CENTER" prefHeight="86.0" prefWidth="374.0" spacing="40" style="-fx-padding: 10;">
                        <Button fx:id="bookButton" onAction="#BookAppointment" style="-fx-background-color: #198B2C; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-pref-width: 120; -fx-pref-height: 40;" text="BOOK" />
                        <Button fx:id="addCancelButton" onAction="#clearAddForm" style="-fx-background-color: #2293C3; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-pref-width: 120; -fx-pref-height: 40;" text="CANCEL" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- Update Appointment Form -->
            <VBox fx:id="updateForm" alignment="CENTER" prefHeight="646.0" prefWidth="498.0" spacing="15"
                  style="-fx-padding: 30; -fx-background-color: #EFEFEF; -fx-border-color: #2293C3;"
                  visible="false" managed="false" VBox.vgrow="ALWAYS">

                <!-- Form Title -->
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2293C3; -fx-padding: 0 0 10 0;"
                       text="Update Appointment" textAlignment="CENTER" />

                <!-- Search Section -->
                <VBox alignment="CENTER" spacing="10" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 5;">
                    <HBox alignment="CENTER" spacing="10">
                        <TextField fx:id="updateSearchAppointmentIdTextField"
                                   promptText="Enter Appointment ID"
                                   style="-fx-font-size: 14px; -fx-pref-width: 250; -fx-min-width: 250; -fx-max-width: 250;" />
                        <Button fx:id="updateSearchButton" onAction="#handleSearchAppointmentById"
                                style="-fx-background-color: #2293C3; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-pref-width: 100; -fx-pref-height: 30;"
                                text="SEARCH" />
                    </HBox>
                </VBox>


                <!-- Form Fields -->
                <VBox alignment="CENTER" prefHeight="494.0" prefWidth="435.0" spacing="20"
                      style="-fx-padding: 20 30 30 30; -fx-background-color: white; -fx-background-radius: 5;">

                    <!-- VIN -->
                    <!-- VIN Field -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;" text="VIN:" />
                        <TextField fx:id="updateVinTextField"
                                   promptText="Enter VIN"
                                   style="-fx-font-size: 14px; -fx-pref-width: 250;" />
                    </HBox>

                    <!-- Service Type -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;" text="Service Type:" />
                        <ComboBox fx:id="updateServiceTypeComboBox"
                                  promptText="Select Service Type"
                                  style="-fx-font-size: 14px; -fx-pref-width: 250;" />
                    </HBox>

                    <!-- Mechanic Dropdown -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label text="Mechanic:" style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;" />
                        <ComboBox fx:id="updateMechanicComboBox" style="-fx-pref-width: 250; -fx-font-size: 14px;" />
                    </HBox>

                    <!-- Service Date -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;" text="Service Date:" />
                        <DatePicker fx:id="updateServiceDatePicker"
                                    style="-fx-font-size: 14px; -fx-pref-width: 250;" />
                    </HBox>

                    <!-- Status -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;" text="Status:" />
                        <ComboBox fx:id="updateStatusComboBox"
                                  promptText="Select Status"
                                  style="-fx-font-size: 14px; -fx-pref-width: 250;" />
                    </HBox>

                    <!-- Buttons -->
                    <HBox alignment="CENTER" spacing="40" style="-fx-padding: 20 0 0 0;">
                        <Button fx:id="updateButton"
                                onAction="#UpdateAppointment"
                                style="-fx-background-color: #198B2C; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-pref-width: 120; -fx-pref-height: 40;"
                                text="UPDATE">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                    <Image url="@../../../Images/icons/update.png" />
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="updateCancelButton"
                                onAction="#clearUpdateForm"
                                style="-fx-background-color: #2293C3; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-pref-width: 120; -fx-pref-height: 40;"
                                text="CANCEL">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                    <Image url="@../../../Images/icons/cancle.png" />
                                </ImageView>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Cancel Appointment Form -->
            <VBox fx:id="cancelForm" alignment="CENTER" prefHeight="646.0" prefWidth="498.0" spacing="15"
                  style="-fx-padding: 30; -fx-background-color: #EFEFEF; -fx-border-color: #2293C3;"
                  visible="false" managed="false" VBox.vgrow="ALWAYS">

                <!-- Form Title -->
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2293C3; -fx-padding: 0 0 10 0;"
                       text="Cancel Appointment" textAlignment="CENTER" />

                <!-- Search Section -->
                <VBox alignment="CENTER" spacing="10"
                      style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 5;">
                    <HBox alignment="CENTER" spacing="10">
                        <TextField fx:id="cancelSearchAppointmentIdTextField"
                                   promptText="Enter Appointment ID"
                                   style="-fx-font-size: 14px; -fx-pref-width: 250; -fx-min-width: 250; -fx-max-width: 250;" />
                        <Button fx:id="cancelSearchButton"
                                onAction="#handleCancelSearchAppointmentById"
                                style="-fx-background-color: #2293C3; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-pref-width: 100; -fx-pref-height: 30;"
                                text="SEARCH">
                        </Button>
                    </HBox>
                </VBox>

                <!-- Form Fields -->
                <VBox alignment="CENTER" prefHeight="494.0" prefWidth="435.0" spacing="20"
                      style="-fx-padding: 20 30 30 30; -fx-background-color: white; -fx-background-radius: 5;">

                    <!-- VIN -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;"
                               text="VIN:" />
                        <TextField fx:id="cancelVinTextField"
                                   style="-fx-font-size: 14px; -fx-pref-width: 250; -fx-min-width: 250; -fx-max-width: 250;"
                                   editable="false" />
                    </HBox>

                    <!-- Service Type Dropdown -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label text="Service Type:" style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;" />
                        <ComboBox fx:id="CancelServiceTypeComboBox" style="-fx-pref-width: 250; -fx-font-size: 14px;" />
                    </HBox>

                    <!-- Mechanic Dropdown -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label text="Mechanic:" style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;" />
                        <ComboBox fx:id="CancelMechanicComboBox" style="-fx-pref-width: 250; -fx-font-size: 14px;" />
                    </HBox>

                    <!-- Service Date -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label text="Service Date:" style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;" />
                        <DatePicker fx:id="cancelServiceDatePicker" style="-fx-pref-width: 250; -fx-font-size: 14px;" />
                    </HBox>

                    <!-- Service Status -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label text="Status:" style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;" />
                        <ComboBox fx:id="CancelStatusComboBox" style="-fx-pref-width: 250; -fx-font-size: 14px;" />
                    </HBox>


                    <!-- Buttons -->
                    <HBox alignment="CENTER" spacing="40" style="-fx-padding: 20 0 0 0;">
                        <Button fx:id="confirmCancelButton"
                                onAction="#CancelAppointment"
                                style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-pref-width: 120; -fx-pref-height: 40;"
                                text="CONFIRM">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                    <Image url="@../../../Images/icons/remove.png" />
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="cancelCancelButton"
                                onAction="#clearCancelForm"
                                style="-fx-background-color: #2293C3; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-pref-width: 120; -fx-pref-height: 40;"
                                text="BACK">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                    <Image url="@../../../Images/icons/cancle.png" />
                                </ImageView>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Search Appointment Form -->
            <VBox fx:id="searchForm" alignment="CENTER" prefHeight="646.0" prefWidth="498.0" spacing="15"
                  style="-fx-padding: 30; -fx-background-color: #EFEFEF; -fx-border-color: #2293C3;"
                  visible="false" managed="false" VBox.vgrow="ALWAYS">

                <!-- Form Title -->
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2293C3; -fx-padding: 0 0 10 0;"
                       text="Search Appointment" textAlignment="CENTER" />

                <!-- Search Section -->
                <VBox alignment="CENTER" spacing="10"
                      style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 5;">
                    <HBox alignment="CENTER" spacing="10">
                        <TextField fx:id="searchAppointmentIdTextField"
                                   promptText="Enter Appointment ID"
                                   style="-fx-font-size: 14px; -fx-pref-width: 250; -fx-min-width: 250; -fx-max-width: 250;" />
                        <Button fx:id="searchButton"
                                style="-fx-background-color: #2293C3; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-pref-width: 100; -fx-pref-height: 30;"
                                text="SEARCH">
                        </Button>
                    </HBox>
                </VBox>

                <!-- Results Section -->
                <VBox alignment="CENTER" prefHeight="494.0" prefWidth="435.0" spacing="20"
                      style="-fx-padding: 20 30 30 30; -fx-background-color: white; -fx-background-radius: 5;">

                    <!-- VIN -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;"
                               text="VIN:" />
                        <TextField fx:id="searchVinTextField"
                                   style="-fx-font-size: 14px; -fx-pref-width: 250; -fx-min-width: 250; -fx-max-width: 250;"
                                   editable="false" />
                    </HBox>

                    <!-- Customer ID -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;"
                               text="Customer ID:" />
                        <TextField fx:id="searchCustomerIdTextField"
                                   style="-fx-font-size: 14px; -fx-pref-width: 250; -fx-min-width: 250; -fx-max-width: 250;"
                                   editable="false" />
                    </HBox>

                    <!-- Customer Name -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;"
                               text="Customer Name:" />
                        <TextField fx:id="searchCustomerNameTextField"
                                   style="-fx-font-size: 14px; -fx-pref-width: 250; -fx-min-width: 250; -fx-max-width: 250;"
                                   editable="false" />
                    </HBox>

                    <!-- Phone -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;"
                               text="Phone:" />
                        <TextField fx:id="searchPhoneTextField"
                                   style="-fx-font-size: 14px; -fx-pref-width: 250; -fx-min-width: 250; -fx-max-width: 250;"
                                   editable="false" />
                    </HBox>

                    <!-- Service Type -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;"
                               text="Service Type:" />
                        <TextField fx:id="searchServiceTypeTextField"
                                   style="-fx-font-size: 14px; -fx-pref-width: 250; -fx-min-width: 250; -fx-max-width: 250;"
                                   editable="false" />
                    </HBox>

                    <!-- Service Date -->
                    <HBox alignment="CENTER" spacing="20">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: black; -fx-min-width: 120;"
                               text="Service Date:" />
                        <TextField fx:id="searchDateTextField"
                                   style="-fx-font-size: 14px; -fx-pref-width: 250; -fx-min-width: 250; -fx-max-width: 250;"
                                   editable="false" />
                    </HBox>

                    <!-- Buttons -->
                    <HBox alignment="CENTER" spacing="40" style="-fx-padding: 20 0 0 0;">
                        <Button fx:id="searchBackButton"
                                style="-fx-background-color: #2293C3; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-pref-width: 120; -fx-pref-height: 40;"
                                text="BACK">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                    <Image url="@../../../Images/icons/cancle.png" />
                                </ImageView>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </center>

    <!-- Right Panel -->
    <right>
        <AnchorPane fx:id="rightPanel" prefHeight="549.0" prefWidth="202.0" style="-fx-border-color: #2293C3;">
            <!-- Book Appointment Button -->
            <Button fx:id="bookAppointmentButton"
                    layoutX="4.0" layoutY="170.0"
                    onAction="#handleBookAppointment"
                    prefHeight="34.0" prefWidth="196.0"
                    style="-fx-background-color: #2293C3; -fx-text-fill: white; -fx-font-weight: bold;"
                    text="Book Appointment" />

            <!-- Update Appointment Button -->
            <Button fx:id="updateAppointmentButton"
                    layoutX="4.0" layoutY="233.0"
                    onAction="#handleUpdateAppointment"
                    prefHeight="34.0" prefWidth="196.0"
