<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.Color?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coretech.coretech.AddAppointmentController">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER" prefHeight="51.0" prefWidth="700.0" style="-fx-background-color: #2293C3; -fx-padding: 10;">
            <Label fx:id="titleLabel" alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 25px; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-family: Inder;" text="Manage Appointments" textAlignment="CENTER" HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <!-- Left Sidebar -->
    <left>
        <VBox prefHeight="600.0" prefWidth="200.0" spacing="12" style="-fx-background-color: white; -fx-border-color: #2293C3;">
            <ImageView fx:id="logoImageView" fitHeight="72.0" fitWidth="143.0">
                <Image url="@../../../../../../Images/BlackVersion.png" />
                <VBox.margin>
                    <Insets left="30.0" />
                </VBox.margin>
                <effect>
                    <DropShadow offsetY="2.0">
                        <color>
                            <Color opacity="0.5896656513214111" />
                        </color>
                    </DropShadow>
                </effect>
            </ImageView>
            <Label fx:id="welcomeLabel" style="-fx-font-size: 14px; -fx-text-fill: black;" text="Welcome, Name">
                <VBox.margin>
                    <Insets bottom="30.0" left="50.0" />
                </VBox.margin>
            </Label>

            <Button fx:id="homeButton" onAction="#handleHome" text="Home" />
            <Button fx:id="customerManagementButton" onAction="#handleCustomerManagement" text="Customer Management" />
            <Button fx:id="vehicleManagementButton" onAction="#handleVehicleManagement" text="Vehicle Management" />
            <Button fx:id="appointmentsButton" onAction="#handleAppointments" text="Appointments" style="-fx-background-color: #A7DAF8;" />
            <VBox fx:id="spacer" VBox.vgrow="ALWAYS">
                <children>
                    <Button fx:id="servicingButton" onAction="#handleServicing" text="Servicing" />
                </children>
            </VBox>
            <Button fx:id="logoutButton" onAction="#handleLogout" text="Log Out" style="-fx-background-color: #2293C3; -fx-text-fill: white;" />
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <VBox alignment="CENTER" spacing="30" style="-fx-padding: 30; -fx-background-color: #EFEFEF; -fx-border-color: #2293C3;">
            <Label fx:id="formTitleLabel" text="Add Appointment" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2293C3;" />
            <VBox spacing="25" style="-fx-padding: 30;">
                <HBox alignment="CENTER" spacing="20">
                    <Label text="VIN:" style="-fx-font-size: 16px; -fx-text-fill: black;" />
                    <TextField fx:id="vinTextField" promptText="Enter VIN" />
                </HBox>
                <HBox alignment="CENTER" spacing="20">
                    <Label text="Customer ID:" style="-fx-font-size: 16px; -fx-text-fill: black;" />
                    <TextField fx:id="customerIdTextField" promptText="Enter Customer ID" />
                </HBox>
                <HBox alignment="CENTER" spacing="20">
                    <Label text="Service Type:" style="-fx-font-size: 16px; -fx-text-fill: black;" />
                    <TextField fx:id="serviceTypeTextField" promptText="Enter Service" />
                </HBox>
                <HBox alignment="CENTER" spacing="20">
                    <Label text="Service Date:" style="-fx-font-size: 16px; -fx-text-fill: black;" />
                    <DatePicker fx:id="serviceDatePicker" promptText="Enter Date" />
                </HBox>
                <HBox alignment="CENTER" spacing="40">
                    <Button fx:id="bookButton" text="BOOK" style="-fx-background-color: #198B2C; -fx-text-fill: white;" />
                    <Button fx:id="cancelButton" text="CANCEL" style="-fx-background-color: #2293C3; -fx-text-fill: white;" />
                </HBox>
            </VBox>
        </VBox>
    </center>

    <!-- Right Panel -->
    <right>
        <AnchorPane>
            <Button fx:id="bookAppointmentButton" layoutX="4.0" layoutY="170.0" onAction="#handleBookAppointment" text="Book an Appointment" />
            <Button fx:id="updateAppointmentButton" layoutX="6.0" layoutY="233.0" onAction="#handleUpdateAppointment" text="Update an Appointment" />
            <Button fx:id="cancelAppointmentButton" layoutX="4.0" layoutY="297.0" onAction="#handleCancelAppointment" text="Cancel an Appointment" />
            <Button fx:id="searchAppointmentsButton" layoutX="6.0" layoutY="363.0" onAction="#handleSearchAppointments" text="Search Appointments" />
        </AnchorPane>
    </right>

</BorderPane>
